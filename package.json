{
  "name": "wrong-question-notebook",
  "version": "0.2.0",
  "description": "数理化错题本 (Electron + FastAPI + SQLite)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mistakenotebook.app",
    "productName": "数理化错题本",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend"
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "数理化错题本-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "数理化错题本"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.education",
      "artifactName": "数理化错题本-${version}.${ext}"
    }
  }
}
